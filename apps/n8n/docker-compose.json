{
  "$schema": "https://schemas.runtipi.io/v2/dynamic-compose.json",
  "schemaVersion": 2,
  "services": [
    {
      "name": "n8n",
      "image": "n8nio/n8n:2.41.3",
      "isMain": true,
      "internalPort": 5678,
      "environment": [
        {
          "key": "N8N_EDITOR_BASE_URL",
          "value": "${APP_PROTOCOL:-http}://${APP_DOMAIN}"
        },
        {
          "key": "N8N_SECURE_COOKIE",
          "value": "false"
        },
        {
          "key": "WEBHOOK_URL",
          "value": "${APP_PROTOCOL:-http}://${APP_DOMAIN}"
        },
        {
          "key": "N8N_ENCRYPTION_KEY",
          "value": "${N8N_ENCRYPTION_KEY}"
        },
        {
          "key": "DB_TYPE",
          "value": "postgresdb"
        },
        {
          "key": "DB_POSTGRESDB_HOST",
          "value": "n8n-db"
        },
        {
          "key": "DB_POSTGRESDB_PORT",
          "value": "5432"
        },
        {
          "key": "DB_POSTGRESDB_DATABASE",
          "value": "n8n"
        },
        {
          "key": "DB_POSTGRESDB_USER",
          "value": "n8n"
        },
        {
          "key": "DB_POSTGRESDB_PASSWORD",
          "value": "${N8N_NR_DB_PASSWORD}"
        },
        {
          "key": "N8N_DEFAULT_BINARY_DATA_MODE",
          "value": "filesystem"
        },
        {
          "key": "EXECUTIONS_MODE",
          "value": "queue"
        },
        {
          "key": "QUEUE_BULL_REDIS_HOST",
          "value": "n8n-redis"
        },
        {
          "key": "QUEUE_BULL_REDIS_PORT",
          "value": "6379"
        },
        {
          "key": "QUEUE_BULL_REDIS_PASSWORD",
          "value": "${N8N_REDIS_PASSWORD}"
        },
        {
          "key": "NODE_FUNCTION_ALLOW_BUILTIN",
          "value": "*"
        },
        {
          "key": "N8N_PROXY_HOPS",
          "value": "1"
        },
        {
          "key": "GENERIC_TIMEZONE",
          "value": "${N8N_GENERIC_TIMEZONE}"
        },
        {
          "key": "N8N_DIAGNOSTICS_ENABLED",
          "value": "${N8N_DIAGNOSTICS_ENABLED}"
        },
        {
          "key": "N8N_VERSION_NOTIFICATIONS_ENABLED",
          "value": "${N8N_VERSION_NOTIFICATIONS_ENABLED}"
        },
        {
          "key": "N8N_TEMPLATES_ENABLED",
          "value": "${N8N_TEMPLATES_ENABLED}"
        },
        {
          "key": "NODE_FUNCTION_ALLOW_EXTERNAL",
          "value": "${N8N_NODE_FUNCTION_ALLOW_EXTERNAL}"
        },
        {
          "key": "OFFLOAD_MANUAL_EXECUTIONS_TO_WORKERS",
          "value": "true"
        },
        {
          "key": "N8N_RUNNERS_MODE",
          "value": "external"
        },
        {
          "key": "N8N_RUNNERS_BROKER_LISTEN_ADDRESS",
          "value": "0.0.0.0"
        },
        {
          "key": "N8N_RUNNERS_AUTH_TOKEN",
          "value": "${N8N_RUNNERS_AUTH_TOKEN}"
        },
        {
          "key": "N8N_NATIVE_PYTHON_RUNNER",
          "value": "true"
        },
        {
          "key": "N8N_INSTANCE_AI_SANDBOX_ENABLED",
          "value": "true"
        },
        {
          "key": "N8N_INSTANCE_AI_SANDBOX_PROVIDER",
          "value": "n8n-sandbox"
        },
        {
          "key": "N8N_SANDBOX_SERVICE_URL",
          "value": "http://n8n-sandbox-api:8080"
        },
        {
          "key": "N8N_SANDBOX_SERVICE_API_KEY",
          "value": "${N8N_SANDBOX_API_KEY}"
        }
      ],
      "dependsOn": {
        "n8n-db": {
          "condition": "service_healthy"
        },
        "n8n-redis": {
          "condition": "service_healthy"
        }
      },
      "volumes": [
        {
          "hostPath": "${APP_DATA_DIR}/data/n8n",
          "containerPath": "/home/node/.n8n"
        }
      ]
    },
    {
      "name": "n8n-worker",
      "image": "n8nio/n8n:2.41.3",
      "command": "worker",
      "environment": [
        {
          "key": "N8N_ENCRYPTION_KEY",
          "value": "${N8N_ENCRYPTION_KEY}"
        },
        {
          "key": "DB_TYPE",
          "value": "postgresdb"
        },
        {
          "key": "DB_POSTGRESDB_HOST",
          "value": "n8n-db"
        },
        {
          "key": "DB_POSTGRESDB_PORT",
          "value": "5432"
        },
        {
          "key": "DB_POSTGRESDB_DATABASE",
          "value": "n8n"
        },
        {
          "key": "DB_POSTGRESDB_USER",
          "value": "n8n"
        },
        {
          "key": "DB_POSTGRESDB_PASSWORD",
          "value": "${N8N_NR_DB_PASSWORD}"
        },
        {
          "key": "N8N_DEFAULT_BINARY_DATA_MODE",
          "value": "filesystem"
        },
        {
          "key": "EXECUTIONS_MODE",
          "value": "queue"
        },
        {
          "key": "QUEUE_BULL_REDIS_HOST",
          "value": "n8n-redis"
        },
        {
          "key": "QUEUE_BULL_REDIS_PORT",
          "value": "6379"
        },
        {
          "key": "QUEUE_BULL_REDIS_PASSWORD",
          "value": "${N8N_REDIS_PASSWORD}"
        },
        {
          "key": "NODE_FUNCTION_ALLOW_BUILTIN",
          "value": "*"
        },
        {
          "key": "GENERIC_TIMEZONE",
          "value": "${N8N_GENERIC_TIMEZONE}"
        },
        {
          "key": "NODE_FUNCTION_ALLOW_EXTERNAL",
          "value": "${N8N_NODE_FUNCTION_ALLOW_EXTERNAL}"
        },
        {
          "key": "N8N_RUNNERS_MODE",
          "value": "external"
        },
        {
          "key": "N8N_RUNNERS_BROKER_LISTEN_ADDRESS",
          "value": "0.0.0.0"
        },
        {
          "key": "N8N_RUNNERS_AUTH_TOKEN",
          "value": "${N8N_RUNNERS_AUTH_TOKEN}"
        },
        {
          "key": "N8N_NATIVE_PYTHON_RUNNER",
          "value": "true"
        }
      ],
      "dependsOn": {
        "n8n": {
          "condition": "service_started"
        },
        "n8n-db": {
          "condition": "service_healthy"
        },
        "n8n-redis": {
          "condition": "service_healthy"
        }
      },
      "volumes": [
        {
          "hostPath": "${APP_DATA_DIR}/data/n8n",
          "containerPath": "/home/node/.n8n"
        }
      ]
    },
    {
      "name": "n8n-db",
      "image": "postgres:18.2",
      "environment": [
        {
          "key": "POSTGRES_USER",
          "value": "tipi"
        },
        {
          "key": "POSTGRES_PASSWORD",
          "value": "${N8N_DB_PASSWORD}"
        },
        {
          "key": "POSTGRES_DB",
          "value": "n8n"
        },
        {
          "key": "POSTGRES_NON_ROOT_USER",
          "value": "n8n"
        },
        {
          "key": "POSTGRES_NON_ROOT_PASSWORD",
          "value": "${N8N_NR_DB_PASSWORD}"
        }
      ],
      "volumes": [
        {
          "hostPath": "${APP_DATA_DIR}/data/postgres",
          "containerPath": "/var/lib/postgresql"
        },
        {
          "hostPath": "${APP_DATA_DIR}/data/init-data.sh",
          "containerPath": "/docker-entrypoint-initdb.d/init-data.sh"
        }
      ],
      "healthCheck": {
        "interval": "5s",
        "timeout": "5s",
        "retries": 10,
        "test": "pg_isready -h localhost -U $$POSTGRES_USER -d $$POSTGRES_DB"
      }
    },
    {
      "name": "n8n-redis",
      "image": "redis:8.4-alpine",
      "command": "redis-server --requirepass ${N8N_REDIS_PASSWORD}",
      "volumes": [
        {
          "hostPath": "${APP_DATA_DIR}/data/redis",
          "containerPath": "/data"
        }
      ],
      "healthCheck": {
        "test": "redis-cli -a $$N8N_REDIS_PASSWORD ping | grep PONG",
        "interval": "10s",
        "timeout": "5s",
        "retries": 5,
        "startPeriod": "10s"
      },
      "environment": [
        {
          "key": "N8N_REDIS_PASSWORD",
          "value": "${N8N_REDIS_PASSWORD}"
        }
      ]
    },
    {
      "name": "n8n-worker-task-runner",
      "image": "n8nio/runners:2.41.3",
      "environment": [
        {
          "key": "N8N_RUNNERS_TASK_BROKER_URI",
          "value": "http://n8n-worker:5679"
        },
        {
          "key": "N8N_RUNNERS_AUTH_TOKEN",
          "value": "${N8N_RUNNERS_AUTH_TOKEN}"
        }
      ],
      "dependsOn": {
        "n8n-worker": {
          "condition": "service_started"
        }
      },
      "healthCheck": {
        "test": "wget -qO- http://localhost:5680/healthz || exit 1",
        "interval": "10s",
        "timeout": "5s",
        "retries": 5,
        "startPeriod": "15s"
      }
    },
    {
      "name": "n8n-sandbox-certs",
      "image": "ghcr.io/n8n-io/n8n-sandbox-service-api:1.5.0",
      "user": "0:0",
      "entrypoint": ["sh", "-c"],
      "command": [
        "[ -f /tls/api/ca.crt ] || bootstrap-mtls.sh --out-dir /tls --api-san n8n-sandbox-api --control-san-prefix n8n-sandbox-runner --world-readable && chown -R sandbox-api:sandbox-api /tls/api && chmod -R a+rX /tls && exec sleep infinity"
      ],
      "environment": [
        {
          "key": "NUM_RUNNERS",
          "value": "1"
        }
      ],
      "volumes": [
        {
          "hostPath": "${APP_DATA_DIR}/data/sandbox-tls",
          "containerPath": "/tls"
        }
      ],
      "healthCheck": {
        "test": "test -f /tls/runner/grpc-client.key",
        "interval": "5s",
        "timeout": "3s",
        "retries": 10
      }
    },
    {
      "name": "n8n-sandbox-api",
      "image": "ghcr.io/n8n-io/n8n-sandbox-service-api:1.5.0",
      "environment": [
        {
          "key": "SANDBOX_API_KEYS",
          "value": "${N8N_SANDBOX_API_KEY}"
        },
        {
          "key": "SANDBOX_API_RUNNER_REGISTRATION_TOKEN",
          "value": "${N8N_SANDBOX_REGISTRATION_TOKEN}"
        },
        {
          "key": "SANDBOX_API_RUNNER_API_KEY",
          "value": "${N8N_SANDBOX_RUNNER_KEY}"
        },
        {
          "key": "SANDBOX_API_GRPC_TLS_CERT_FILE",
          "value": "/tls/api/grpc-server.crt"
        },
        {
          "key": "SANDBOX_API_GRPC_TLS_KEY_FILE",
          "value": "/tls/api/grpc-server.key"
        },
        {
          "key": "SANDBOX_API_GRPC_TLS_CLIENT_CA_FILE",
          "value": "/tls/api/ca.crt"
        },
        {
          "key": "SANDBOX_API_RUNNER_CONTROL_GRPC_TLS_CA_FILE",
          "value": "/tls/api/ca.crt"
        },
        {
          "key": "SANDBOX_API_RUNNER_CONTROL_GRPC_TLS_CERT_FILE",
          "value": "/tls/api/control-grpc-api-client.crt"
        },
        {
          "key": "SANDBOX_API_RUNNER_CONTROL_GRPC_TLS_KEY_FILE",
          "value": "/tls/api/control-grpc-api-client.key"
        },
        {
          "key": "SANDBOX_API_RUNNER_CONTROL_GRPC_TLS_SERVER_NAME",
          "value": "n8n-sandbox-runner-1"
        }
      ],
      "dependsOn": {
        "n8n-sandbox-certs": {
          "condition": "service_healthy"
        }
      },
      "volumes": [
        {
          "hostPath": "${APP_DATA_DIR}/data/sandbox-tls",
          "containerPath": "/tls",
          "readOnly": true
        }
      ],
      "healthCheck": {
        "test": "wget -qO- http://localhost:8080/healthz || exit 1",
        "interval": "5s",
        "timeout": "3s",
        "retries": 5,
        "startPeriod": "10s"
      }
    },
    {
      "name": "n8n-sandbox-runner-1",
      "image": "ghcr.io/n8n-io/n8n-sandbox-service-runner-dind:1.5.0",
      "privileged": true,
      "environment": [
        {
          "key": "SANDBOX_RUNNER_REGISTRATION_TOKEN",
          "value": "${N8N_SANDBOX_REGISTRATION_TOKEN}"
        },
        {
          "key": "SANDBOX_RUNNER_API_KEYS",
          "value": "${N8N_SANDBOX_RUNNER_KEY}"
        },
        {
          "key": "SANDBOX_RUNNER_API_GRPC_ADDR",
          "value": "n8n-sandbox-api:9090"
        },
        {
          "key": "SANDBOX_RUNNER_HTTP_BASE_URL",
          "value": "https://n8n-sandbox-runner-1:8080"
        },
        {
          "key": "SANDBOX_RUNNER_CONTROL_GRPC_LISTEN_ADDR",
          "value": ":9091"
        },
        {
          "key": "SANDBOX_RUNNER_CONTROL_GRPC_ADVERTISE_ADDR",
          "value": "n8n-sandbox-runner-1:9091"
        },
        {
          "key": "SANDBOX_RUNNER_ID",
          "value": "runner-1"
        },
        {
          "key": "SANDBOX_RUNNER_DOCKER_SANDBOX_IMAGE",
          "value": "ghcr.io/n8n-io/n8n-sandbox-service-sandbox:1.5.0"
        },
        {
          "key": "SANDBOX_RUNNER_REGISTRATION_GRPC_CA_FILE",
          "value": "/tls/runner/ca.crt"
        },
        {
          "key": "SANDBOX_RUNNER_REGISTRATION_GRPC_CERT_FILE",
          "value": "/tls/runner/grpc-client.crt"
        },
        {
          "key": "SANDBOX_RUNNER_REGISTRATION_GRPC_KEY_FILE",
          "value": "/tls/runner/grpc-client.key"
        },
        {
          "key": "SANDBOX_RUNNER_REGISTRATION_GRPC_SERVER_NAME",
          "value": "n8n-sandbox-api"
        },
        {
          "key": "SANDBOX_RUNNER_CONTROL_GRPC_TLS_CERT_FILE",
          "value": "/tls/runner/control-grpc-server.crt"
        },
        {
          "key": "SANDBOX_RUNNER_CONTROL_GRPC_TLS_KEY_FILE",
          "value": "/tls/runner/control-grpc-server.key"
        },
        {
          "key": "SANDBOX_RUNNER_CONTROL_GRPC_TLS_CLIENT_CA_FILE",
          "value": "/tls/runner/ca.crt"
        }
      ],
      "dependsOn": {
        "n8n-sandbox-api": {
          "condition": "service_healthy"
        }
      },
      "volumes": [
        {
          "hostPath": "${APP_DATA_DIR}/data/sandbox-tls",
          "containerPath": "/tls",
          "readOnly": true
        }
      ]
    }
  ]
}
