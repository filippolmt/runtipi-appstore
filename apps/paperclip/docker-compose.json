{
  "$schema": "https://schemas.runtipi.io/v2/dynamic-compose.json",
  "schemaVersion": 2,
  "services": [
    {
      "name": "paperclip",
      "image": "ghcr.io/paperclipai/paperclip:2026.1005.0",
      "isMain": true,
      "internalPort": 3100,
      "environment": [
        {
          "key": "PAPERCLIP_DEPLOYMENT_MODE",
          "value": "authenticated"
        },
        {
          "key": "PAPERCLIP_DEPLOYMENT_EXPOSURE",
          "value": "private"
        },
        {
          "key": "PAPERCLIP_PUBLIC_URL",
          "value": "${APP_PROTOCOL:-http}://${APP_DOMAIN}"
        },
        {
          "key": "BETTER_AUTH_SECRET",
          "value": "${BETTER_AUTH_SECRET}"
        },
        {
          "key": "PAPERCLIP_TOOL_ACTION_SIGNING_SECRET",
          "value": "${PAPERCLIP_TOOL_ACTION_SIGNING_SECRET}"
        },
        {
          "key": "ANTHROPIC_API_KEY",
          "value": "${ANTHROPIC_API_KEY}"
        },
        {
          "key": "OPENAI_API_KEY",
          "value": "${OPENAI_API_KEY}"
        },
        {
          "key": "PAPERCLIP_TELEMETRY_DISABLED",
          "value": "1"
        }
      ],
      "deploy": {
        "resources": {
          "limits": {
            "pids": 2048
          }
        }
      },
      "volumes": [
        {
          "hostPath": "${APP_DATA_DIR}/data/paperclip",
          "containerPath": "/paperclip"
        }
      ],
      "healthCheck": {
        "test": "curl -fsS http://localhost:3100/api/health || exit 1",
        "interval": "30s",
        "timeout": "5s",
        "retries": 5,
        "startPeriod": "60s"
      }
    }
  ]
}
