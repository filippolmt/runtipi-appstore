{
  "$schema": "https://schemas.runtipi.io/v2/dynamic-compose.json",
  "schemaVersion": 2,
  "services": [
    {
      "name": "telegram-find-prices-init",
      "image": "ghcr.io/filippolmt/telegram-find-prices:1.1.1",
      "user": "root",
      "entrypoint": ["/bin/sh", "-c"],
      "command": ["chown 1000:1000 /app/data && : > /tmp/ready && exec sleep infinity"],
      "stopGracePeriod": "1s",
      "healthCheck": {
        "test": "test -f /tmp/ready",
        "interval": "5s",
        "timeout": "3s",
        "retries": 20,
        "startPeriod": "2s"
      },
      "volumes": [
        {
          "hostPath": "${APP_DATA_DIR}/data/bot",
          "containerPath": "/app/data"
        }
      ]
    },
    {
      "name": "telegram-find-prices",
      "image": "ghcr.io/filippolmt/telegram-find-prices:1.1.1",
      "isMain": true,
      "dependsOn": {
        "telegram-find-prices-init": {
          "condition": "service_healthy"
        }
      },
      "environment": [
        { "key": "API_ID", "value": "${API_ID}" },
        { "key": "API_HASH", "value": "${API_HASH}" },
        { "key": "BOT_TOKEN", "value": "${BOT_TOKEN}" },
        { "key": "PHONE_NUMBER", "value": "${PHONE_NUMBER}" },
        { "key": "CLIENT_SESSION_STRING", "value": "${CLIENT_SESSION_STRING}" },
        { "key": "ALLOWED_USERS", "value": "${ALLOWED_USERS}" },
        { "key": "USERNAME", "value": "${USERNAME:-}" },
        { "key": "CHANNEL_FOLDER", "value": "${CHANNEL_FOLDER:-}" },
        { "key": "TIMEZONE", "value": "${TIMEZONE:-UTC}" },
        { "key": "DAILY_SUMMARY_HOUR", "value": "${DAILY_SUMMARY_HOUR:-21}" }
      ],
      "volumes": [
        {
          "hostPath": "${APP_DATA_DIR}/data/bot",
          "containerPath": "/app/data"
        }
      ]
    }
  ]
}
